<?xml version="1.0" encoding="utf-8"?>
<!-- NAS / WebDAV servers on the LAN are usually plain HTTP or self-signed HTTPS (trusted per server in the app). -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>
</network-security-config>
